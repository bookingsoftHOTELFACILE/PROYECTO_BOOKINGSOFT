{
  "name": "proyecto_bookingsoft",
  "version": "1.0.0",
  "description": "Sistema de Gestion de Reservas BookingSoft con Node.js, Express, TypeScript y Docker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "jest --detectOpenHandles",
    "audit": "npm audit"
  },
  "keywords": [
    "booking",
    "reservas",
    "express",
    "typescript",
    "docker",
    "rest-api"
  ],
  "author": "BookingSoft Team",
  "license": "ISC",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "helmet": "7.1.0",
    "morgan": "1.10.0",
    "zod": "3.23.8"
  },
  "overrides": {
    "path-to-regexp": "0.1.12",
    "qs": "6.14.1",
    "cookie": "0.7.2",
    "on-headers": "1.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/morgan": "1.9.9",
    "@types/node": "20.12.12",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "rimraf": "5.0.7",
    "supertest": "7.0.0",
    "ts-jest": "29.1.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  }
}
